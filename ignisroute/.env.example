# PostgreSQL via Session Pooler (recomendado — funciona em redes sem IPv6)
DB_URL=postgresql://postgres.SEU_PROJECT_REF:SUA_SENHA_URL_ENCODED@aws-1-us-east-1.pooler.supabase.com:6543/postgres

# API REST Supabase (opcional — fallback automático)
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_KEY=sua-chave-anon-ou-service

# Senhas com [, ], @ ou # devem ser codificadas na URL:
# [ = %5B   ] = %5D   @ = %40   # = %23
